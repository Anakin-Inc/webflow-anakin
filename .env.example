# Copy to .env and fill in with real values. Never commit .env.

PORT=3000
NODE_ENV=development

# From the app's page in Webflow's Developer Portal
# (https://developers.webflow.com/data/reference/oauth-app — "Register an
# App"). redirect_uri below must exactly match what's registered there, or
# the token exchange fails with invalid_grant.
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback

# 32 raw bytes, base64-encoded — the AES-256-GCM key used to encrypt access
# tokens at rest (lib/token-store.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate via a secrets manager in production; never commit a real value.
TOKEN_ENCRYPTION_KEY=

# From https://anakin.io/dashboard
ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io/v1

# Session cookie signing is not used (cookies here are opaque random IDs,
# not JWTs) — see README's "Token storage design" section for why. Leave
# unset unless you change lib/session.js to sign cookies.

# Set to "1" only in local/CI test runs to expose GET /__test__/counters,
# used by scripts/smoke-test.js to prove the CSRF state check gates the
# Webflow token-exchange network call. Must never be set in production —
# server.js refuses to mount that route unless NODE_ENV !== "production".
EXPOSE_TEST_COUNTERS=0
